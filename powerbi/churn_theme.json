{
  "name": "Telco Churn",
  "dataColors": ["#B4432F", "#3D5A73", "#B3B8BF", "#C98B3A", "#6E8B74", "#8A6F9E", "#5E6670", "#D9B8A9"],
  "background": "#FFFFFF",
  "foreground": "#1E2329",
  "tableAccent": "#B4432F",
  "good": "#3D5A73",
  "neutral": "#B3B8BF",
  "bad": "#B4432F",
  "maximum": "#B4432F",
  "center": "#E8CFC7",
  "minimum": "#F7F2F0",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1E2329" },
    "title":   { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1E2329" },
    "header":  { "fontSize": 10, "fontFace": "Segoe UI Semibold", "color": "#1E2329" },
    "label":   { "fontSize": 9,  "fontFace": "Segoe UI", "color": "#5F656D" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 11,
          "fontColor": { "solid": { "color": "#1E2329" } },
          "alignment": "left"
        }],
        "subTitle": [{
          "fontFamily": "Segoe UI",
          "fontSize": 9,
          "fontColor": { "solid": { "color": "#6B7178" } }
        }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "categoryAxis": [{
          "showAxisTitle": false,
          "fontFamily": "Segoe UI",
          "fontSize": 9,
          "labelColor": { "solid": { "color": "#5F656D" } }
        }],
        "labels": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 10,
          "color": { "solid": { "color": "#1E2329" } }
        }],
        "legend": [{ "show": false }],
        "layout": [{ "clusteredGapSize": 40 }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "categoryAxis": [{
          "showAxisTitle": false,
          "fontFamily": "Segoe UI",
          "fontSize": 9,
          "labelColor": { "solid": { "color": "#5F656D" } }
        }],
        "labels": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 10,
          "color": { "solid": { "color": "#1E2329" } }
        }],
        "legend": [{ "show": false }],
        "layout": [{ "clusteredGapSize": 40 }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 24,
          "color": { "solid": { "color": "#1E2329" } }
        }],
        "categoryLabels": [{
          "show": true,
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "color": { "solid": { "color": "#5F656D" } }
        }]
      }
    },
    "cardVisual": {
      "*": {
        "value": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 24,
          "fontColor": { "solid": { "color": "#1E2329" } }
        }],
        "label": [{
          "show": true,
          "fontFamily": "Segoe UI",
          "fontSize": 10,
          "fontColor": { "solid": { "color": "#5F656D" } }
        }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 9,
          "fontColor": { "solid": { "color": "#5F656D" } },
          "backColor": { "solid": { "color": "#FFFFFF" } }
        }],
        "values": [{
          "fontFamily": "Segoe UI",
          "fontSize": 9,
          "fontColorPrimary": { "solid": { "color": "#1E2329" } },
          "fontColorSecondary": { "solid": { "color": "#1E2329" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#FAF9F7" } }
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#ECEAE6" } },
          "rowPadding": 4
        }]
      }
    }
  }
}
